# ---------------------------------------------------------------- utilities

_LOGGING_DIR = None    # daemon 解析出的生效缓存目录（CLI 侧保持 None）
_cli_log_dir = None    # CLI 侧惰性解析结果（锚点未知的两级链）


def xdg_cache_dir():
    """XDG 缓存档：$XDG_CACHE_HOME/r3，未设置则 ~/.cache/r3（回退链第二级）。"""
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    return os.path.join(base, "r3")


def resolve_cache_dir(anchor=None):
    """缓存目录多级回退链（v1.1.x）：
    ① R3_CACHE_DIR（显式指定）→ ② XDG ~/.cache/r3 → ③ 首次 open 文件所在
    目录下的 .r3cache/（anchor 档）→ ④ 纯内存兜底。
    每级先 makedirs、再 probe_writable（mkstemp+unlink 实写探针），选第一个
    可写层级落盘。返回 (生效绝对路径或 None, 回退原因说明)。
    """
    chain = []
    if R3_CACHE_DIR:
        chain.append(("R3_CACHE_DIR", R3_CACHE_DIR))
    chain.append(("XDG 缓存目录", xdg_cache_dir()))
    if anchor:
        chain.append(("文件所在目录", os.path.join(anchor, ".r3cache")))
    tried = []
    for label, d in chain:
        try:
            os.makedirs(d, exist_ok=True)
            if probe_writable(d):
                if not tried:
                    # v1.3.1：restart 传递旧缓存目录时，标签说明来源是
                    # “上次生效缓存目录”，不再误标成用户显式 R3_CACHE_DIR。
                    if (label == "R3_CACHE_DIR"
                            and R3_CACHE_REASON_OVERRIDE):
                        reason = R3_CACHE_REASON_OVERRIDE
                    else:
                        reason = f"首选层级：{label}（{d}）"
                else:
                    reason = (f"回退：{'、'.join(tried)} 不可写 → "
                              f"采用 {label}（{d}）")
                return d, reason
        except OSError:
            pass
        tried.append(f"{label}({d})")
    return None, (f"回退：{'、'.join(tried)} 均不可写"
                  " → 纯内存兜底（不落盘）")


def log_dir():
    """daemon 用生效缓存目录；CLI 侧（daemon 未解析前）用两级链结果。"""
    global _cli_log_dir
    if _LOGGING_DIR:
        return _LOGGING_DIR
    if _cli_log_dir is None:
        _cli_log_dir, _ = resolve_cache_dir(None)
    return _cli_log_dir


def log(msg):
    """daemon 日志（启动/命令/异常）。目录不可写/内存兜底时静默放弃。"""
    try:
        d = log_dir()
        if not d:
            return
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, "daemon.log"), "a",
                  encoding="utf-8", errors="replace") as f:
            f.write(time.strftime("[%Y-%m-%d %H:%M:%S] ") + msg + "\n")
    except OSError:
        pass


def env_int(name, default):
    v = os.environ.get(name)
    if v:
        try:
            return int(v)
        except ValueError:
            pass
    return default


def probe_writable(directory):
    """真实写探针：在 directory 里 mkstemp + unlink 验证可写（返回 bool）。

    实测陷阱（v1.1 后修）：os.makedirs(d, exist_ok=True) 对"已存在但只读"的
    目录会直接成功返回、不抛异常——靠它判可写性会漏判，随后写 state.json
    才 PermissionError。所以必须用真实写操作判可写。
    """
    try:
        fd, tmp = tempfile.mkstemp(prefix=".r3-wt-", dir=directory)
        os.close(fd)
        os.unlink(tmp)
        return True
    except OSError:
        return False


def r2_version():
    out = subprocess.run([R2_BIN, "-v"], capture_output=True, text=True,
                         errors="replace").stdout
    first = out.splitlines()[0].strip() if out else "r2-unknown"
    return first  # 例: "radare2 6.1.9 +48 abi:127 @ linux-x86_64"


def file_sha256(path):
    """文件内容 SHA-256（缓存键与 meta 归属校验共用，v1.1 决策 #10）。"""
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def version_slug(version):
    return "".join(c if c.isalnum() or c in ".-_" else "-" for c in version)


def meta_path_for(projdir):
    """工程缓存旁的归属 meta 文件路径：<projdir>.meta.json（v1.1 决策 #10）。"""
    return projdir + ".meta.json"


def econf_path_for(cache_dir, sid):
    """会话 e 配置落盘路径：<cache_dir>/econf/<sid>.json（v1.3 决策 #25）。"""
    return os.path.join(cache_dir, "econf", f"{sid}.json")


def e_cmd_name(command):
    """从「e 名=值」样命令中取配置名；不是该形态返回 None。

    只做旁路识别，不解析语义、不改写命令与输出（v1.3 决策 #25）。
    """
    if not command or not command.strip():
        return None
    parts = command.strip().split(None, 1)
    if len(parts) != 2 or parts[0] != "e" or "=" not in parts[1]:
        return None
    return parts[1].split("=", 1)[0]


def cache_key(path, version):
    """缓存键 = SHA-256(文件内容) + SHA-256(realpath)[:12] + r2 版本号。

    v1.3 决策 #24：加 realpath 维。同内容不同路径的副本不再共享工程缓存
    （各用各的 key），meta 归属校验也追加 path 比对。v1.2 旧键自然不匹配
    → 未命中重分析，永不误用。
    """
    rp = os.path.realpath(os.path.abspath(os.path.expanduser(path)))
    return (file_sha256(path) + "-"
            + hashlib.sha256(rp.encode("utf-8")).hexdigest()[:12] + "-"
            + version_slug(version))


def info_summary_line(sess):
    """open 成功的文件信息速览（v1.3 决策 #28）。

    发 `iIj` 解析 arch/bits/PIE/canary/NX/stripped/静态动态链接/大小。
    任何失败/超时返回 None，调用方省略该行，不影响 open 成功与否。
    """
    if sess.r2 is None:
        return None
    try:
        out, timed_out = sess.r2.cmd("iIj", 10)
    except Exception:
        return None
    if timed_out or out is None:
        return None
    try:
        d = json.loads(out.decode("utf-8", "replace"))
        if not isinstance(d, dict):
            return None
    except (ValueError, UnicodeDecodeError):
        return None
    parts = [f"arch={d.get('arch') or '?'}"]
    if d.get("bits"):
        parts.append(f"{d.get('bits')}-bit")
    if d.get("pic"):
        parts.append("PIE")
    if d.get("canary"):
        parts.append("canary")
    if d.get("nx"):
        parts.append("NX")
    parts.append("stripped" if d.get("stripped") else "未stripped")
    parts.append("静态链接" if d.get("static") else "动态链接")
    if d.get("binsz"):
        parts.append(f"{d['binsz'] / 1024:.1f} KB")
    return "文件信息: " + ", ".join(parts)


def session_id(path):
    """sid = sha256(realpath(文件)) 前 16 位十六进制（v1.2 §3.5）。

    不用路径原样（含 /、空格、中文污染日志/协议），不用打开顺序——同一文件
    永远映射同一 sid，会话按 realpath 自动汇聚（决策 #17）。
    """
    rp = os.path.realpath(os.path.abspath(os.path.expanduser(path)))
    return hashlib.sha256(rp.encode("utf-8")).hexdigest()[:16]


